# Copia questi nomi nella scheda "Variables" del servizio su Railway e inserisci i tuoi valori.
TELEGRAM_TOKEN=
# Lascia vuoto: la prima chat che scrive /start al bot diventa la proprietaria.
TELEGRAM_CHAT_ID=
# Una password lunga e casuale per le API (/observations, /calls, /stats).
API_KEY=
PLATFORM=console
BUDGET=500000
SIM_MODE=true
# DATABASE_URL viene impostata da Railway quando colleghi Postgres.

# Chiave API di fut-db.com (premium). Vuota = fornitore spento.
FUTDB_TOKEN=
